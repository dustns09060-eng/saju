# ── 서버 ─────────────────────────────────────────────
PORT=3000

# ── 주문 저장소 ──────────────────────────────────────
# 설정하면 Postgres 사용 (운영 필수 — 재배포해도 주문·결제 기록 유지).
# 비우면 로컬 파일(data/orders/) 사용 (개발용, 재배포 시 유실).
# Railway 에서 Postgres 추가하면 이 변수가 자동 주입됩니다.
DATABASE_URL=

# ── AI 호출 방식 ─────────────────────────────────────
# api : Anthropic API + API 키 (쓴 만큼 후불 과금). 유료 서비스는 반드시 이 방식.
# cli : 로컬 claude CLI + 구독요금제. 개인 개발/테스트 전용 (배포 금지).
AI_PROVIDER=api

# [AI_PROVIDER=api 일 때] console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=
# 상세 풀이 모델 (품질/비용): claude-sonnet-5 (기본) · claude-haiku-4-5 (저렴) · claude-opus-5 (고품질)
CLAUDE_MODEL=claude-sonnet-5
# 무료 맛보기(인사·운명의 짝·위기) 모델 — 첫인상이라 기본 sonnet. 비용 줄이려면 claude-haiku-4-5
CLAUDE_TEASER_MODEL=claude-sonnet-5
# 풀이 최대 토큰
CLAUDE_MAX_TOKENS=8000

# [AI_PROVIDER=cli 일 때만] `claude setup-token` 으로 발급한 토큰
CLAUDE_CODE_OAUTH_TOKEN=
# claude 실행 파일 경로 (PATH 에 있으면 비워두기)
CLAUDE_BIN=

# 한 번 호출당 타임아웃(ms)
CLAUDE_TIMEOUT_MS=180000

# ── 결제 ─────────────────────────────────────────────
# mock    : 실제 결제 없이 통과 (개발/데모)
# portone : 포트원 V2 실결제 (사업자등록 + 통신판매업 신고 + 아래 값 3개 필요)
PAYMENT_PROVIDER=mock
SAJU_PRICE_KRW=2900

# [PAYMENT_PROVIDER=portone 일 때] 포트원 콘솔에서 확인
PORTONE_STORE_ID=          # Store ID (공개값, 프론트에 노출됨)
PORTONE_CHANNEL_KEY=       # 결제채널 키 (공개값, 프론트에 노출됨)
PORTONE_API_SECRET=        # API Secret (서버 전용, 절대 커밋/노출 금지)

# ── 무료 쿠폰 (베타 후기단·지인) ─────────────────────
# 쉼표로 구분한 코드. 결제창에서 이 코드를 넣으면 결제 없이 풀이가 열림.
COUPON_CODES=              # 예: BETA2026,FRIEND,REVIEW
COUPON_MAX_TOTAL=          # 전체 사용 상한(정수). 비우면 무제한

# ── 관리자 ───────────────────────────────────────────
# /api/admin/reviews?key=... 로 후기 승인/삭제. 길고 무작위한 값으로.
ADMIN_KEY=

# 랜딩 "지금까지 N번" 노출 시작 최소 누적 수
STATS_MIN_SHOW=30
