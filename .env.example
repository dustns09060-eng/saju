# ── 서버 ─────────────────────────────────────────────
PORT=3000

# ── AI 호출 방식 ─────────────────────────────────────
# api : Anthropic API + API 키 (쓴 만큼 후불 과금). 유료 서비스는 반드시 이 방식.
# cli : 로컬 claude CLI + 구독요금제. 개인 개발/테스트 전용 (배포 금지).
AI_PROVIDER=api

# [AI_PROVIDER=api 일 때] console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=
# 상세 풀이 모델 (품질/비용): claude-sonnet-5 (기본) · claude-haiku-4-5 (저렴) · claude-opus-5 (고품질)
CLAUDE_MODEL=claude-sonnet-5
# 무료 맛보기(인사·운명의 짝·위기) 모델 — 저렴한 것 권장
CLAUDE_TEASER_MODEL=claude-haiku-4-5
# 풀이 최대 토큰
CLAUDE_MAX_TOKENS=8000

# [AI_PROVIDER=cli 일 때만] `claude setup-token` 으로 발급한 토큰
CLAUDE_CODE_OAUTH_TOKEN=
# claude 실행 파일 경로 (PATH 에 있으면 비워두기)
CLAUDE_BIN=

# 한 번 호출당 타임아웃(ms)
CLAUDE_TIMEOUT_MS=180000

# ── 결제 ─────────────────────────────────────────────
# mock    : 실제 결제 없이 통과 (개발/데모)
# portone : 포트원(아임포트) V2 — 사업자등록 + 아래 키 필요, src/lib/payments.js TODO 구현
PAYMENT_PROVIDER=mock
# 풀이 1건 가격(원)
SAJU_PRICE_KRW=2900

# [PAYMENT_PROVIDER=portone 일 때]
PORTONE_STORE_ID=
PORTONE_API_SECRET=
